# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring. .env faylini hech qachon Git'ga yuklamang.

# --- Server ---
NODE_ENV=production
PORT=3000
# Nginx / Cloudflare orqasida ishlasangiz, true qiling (haqiqiy IP manzil uchun)
TRUST_PROXY=true

# --- Telegram bot ---
# @BotFather dan olingan token
BOT_TOKEN=
# Ilovaning ochiq HTTPS manzili (oxirida / siz). Misol: https://qarz.example.uz
WEBAPP_URL=
# webhook (tavsiya) yoki polling (HTTPS manzilsiz sinash uchun) yoki off
BOT_MODE=webhook

# --- Admin panel (/admin/) ---
ADMIN_USERNAME=admin
# Kamida 8 belgi. Murakkab parol tanlang!
ADMIN_PASSWORD=
# Tasodifiy uzun qator (kamida 16 belgi). Hosil qilish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Ixtiyoriy ---
DB_PATH=data/qarzdaftar.sqlite
TZ_NAME=Asia/Tashkent
# Muddati o'tgan qarzlar haqida eslatma yuboriladigan soat (mahalliy vaqt, 0-23)
REMINDER_HOUR=9
# Faqat lokal sinash uchun (Telegramsiz ochish). Production'da YOQMANG.
DEV_MODE=false
